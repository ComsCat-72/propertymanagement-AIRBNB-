# Copy this file to `.env` for local development, and add the same values to your
# hosting provider (Vercel: Project Settings -> Environment Variables) for
# Production, Preview and Development. Never commit a real `.env`.

# ---------------------------------------------------------------------------
# Supabase — client (safe to expose, shipped in the browser bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---------------------------------------------------------------------------
# Supabase — server only (never prefix these with VITE_)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-ref"
# Bypasses RLS. Required only for privileged server-side operations.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Cloudinary — server only. Required for all image uploads (listings + avatars).
# Values come from the Cloudinary dashboard -> Settings -> API Keys.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional alternative to the three variables above:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"